# ============================================================
# Variables de entorno — Sistema de Solicitudes
# Copiar a .env y ajustar antes de ejecutar
# NUNCA commitear .env con valores reales
# ============================================================

# --- Base de datos ---
DB_URL=jdbc:postgresql://localhost:5432/solicitudes
DB_USER=postgres
DB_PASSWORD=cambia_esto

# --- Servidor ---
PORT=8081

# --- JWT (generar un secreto aleatorio en produccion) ---
# Generar: openssl rand -base64 32
JWT_SECRET=cambia_esto_en_produccion_con_valor_aleatorio_de_256bits
JWT_EXPIRATION_MS=900000          # 15 minutos (access token)
JWT_REFRESH_EXPIRATION_MS=604800000  # 7 dias (refresh token)
JWT_ISSUER=solicitudes-api
JWT_AUDIENCE=solicitudes-client

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Seguridad de sesion ---
SESSION_SECURE=false              # true en produccion con HTTPS

# --- Datos institucionales (aparecen en el PDF del pedido) ---
COMPANY_NAME=JUAREZ DE ORIENTE S.A. DE C.V.
COMPANY_ADDRESS=AV. TULANCINGO NO. 103 SAN MIGUEL VINDHO, MPIO. DE TULA DE ALLENDE, HIDALGO
COMPANY_POSTAL_CODE=42842
COMPANY_RFC=JOR070518U13
COMPANY_PHONE=(01-773) 78-5-04-97
COMPANY_EXTENSION=125 - 126
COMPANY_DOCUMENT_CODE=CJ-FA-44 REV. 0
# Lista de autorizadores separados por coma (aparecen en el select del formulario)
COMPANY_AUTHORIZERS=Sr. Miguel Angel Luna,Lic. Juana Reyes Corona,Gerencia General

# --- Seeds de desarrollo (primer arranque) ---
SEED_ADMIN_PASSWORD=Admin123!
SEED_CAPTURISTA_PASSWORD=Capturista1!
