# ============================================================
# Variables de entorno — Sistema de Solicitudes (Backend)
# Copiar a .env y ajustar antes de ejecutar localmente
# NUNCA commitear .env con valores reales
# ============================================================

# --- Base de datos (local) ---
DB_URL=jdbc:postgresql://localhost:5432/solicitudes
DB_USER=postgres
DB_PASSWORD=cambia_esto

# En Railway, usa el plugin PostgreSQL y configura:
#   DB_URL=jdbc:postgresql://${{Postgres.PGHOST}}:${{Postgres.PGPORT}}/${{Postgres.PGDATABASE}}
#   DB_USER=${{Postgres.PGUSER}}
#   DB_PASSWORD=${{Postgres.PGPASSWORD}}

# --- Servidor ---
PORT=8080

# --- JWT (generar un secreto aleatorio en produccion) ---
# Generar: openssl rand -base64 48
JWT_SECRET=cambia_esto_en_produccion_con_valor_aleatorio_largo
JWT_EXPIRATION_MS=900000              # 15 min (access token)
JWT_REFRESH_EXPIRATION_MS=604800000   # 7 dias (refresh token)
JWT_ISSUER=solicitudes-api
JWT_AUDIENCE=solicitudes-client

# --- CORS (URLs del frontend separadas por coma) ---
# Local:
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Railway (reemplaza con la URL real del frontend):
# CORS_ALLOWED_ORIGINS=https://solicitudes-frontend.up.railway.app

# --- Cookie de refresh token ---
# Local:
COOKIE_SAME_SITE=Lax
COOKIE_SECURE=false
# Railway (frontend y backend en dominios distintos):
# COOKIE_SAME_SITE=None
# COOKIE_SECURE=true

# --- Datos institucionales (aparecen en el PDF) ---
COMPANY_NAME=JUAREZ DE ORIENTE S.A. DE C.V.
COMPANY_ADDRESS=AV. TULANCINGO NO. 103 SAN MIGUEL VINDHO,
COMPANY_CITY_LINE=MPIO. DE TULA DE ALLENDE, HIDALGO.
COMPANY_POSTAL_CODE=42842
COMPANY_RFC=JOR070518U13
COMPANY_PHONE=(01-773) 78-5-04-97
COMPANY_EXTENSION=125 - 126
COMPANY_DOCUMENT_CODE=CJ-FA-44 REV. 0

# Lista separada por coma — sin espacios después de la coma
COMPANY_AUTHORIZERS=C. Adelaido Corona Ramírez,Lic. Juana Reyes Corona,Mildred Allison Morales Garcia,Lic. Laura Corona Sanchéz

# --- Contraseñas de seeds (primer arranque) ---
SEED_ADMIN_PASSWORD=Admin123!
SEED_CAPTURISTA_PASSWORD=Capturista1!
