<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- ===== DESARROLLO: salida legible en consola ===== -->
    <springProfile name="default,local">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{yyyy-MM-dd HH:mm:ss} [%X{correlationId}] %-5level %logger{36} - %msg%n</pattern>
                <charset>UTF-8</charset>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
        <logger name="mx.juarezdeoriente" level="DEBUG"/>
    </springProfile>

    <!-- ===== PRODUCCIÓN: JSON estructurado para log aggregation ===== -->
    <springProfile name="prod,production">
        <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
                <pattern>{"timestamp":"%d{yyyy-MM-ddTHH:mm:ss.SSSZ}","level":"%level","correlationId":"%X{correlationId}","logger":"%logger{36}","message":"%replace(%msg){'\"','\\\"'}","thread":"%thread"}%n</pattern>
                <charset>UTF-8</charset>
            </encoder>
        </appender>
        <root level="WARN">
            <appender-ref ref="JSON_CONSOLE"/>
        </root>
        <logger name="mx.juarezdeoriente" level="INFO"/>
        <!-- No loguear contraseñas ni tokens completos -->
        <logger name="org.springframework.security" level="WARN"/>
    </springProfile>

</configuration>
